-- ============================================================
-- SQL Window Functions
-- Topics: SUM OVER, COUNT OVER, MIN OVER, MAX OVER,
-- RANK, DENSE_RANK, PARTITION BY, ORDER BY
-- Dataset: E-commerce (Google BigQuery)
-- ============================================================


-- 1. Monthly Advertising Cost Percentage
-- Calculate each month's share of total paid search
-- advertising costs using a window function.

SELECT
    date,
    ROUND(
        SAFE_DIVIDE(cost, SUM(cost) OVER()) * 100,
        2
    ) AS cost_percent
FROM (
    SELECT
        DATE(
            EXTRACT(YEAR FROM date),
            EXTRACT(MONTH FROM date),
            1
        ) AS date,
        SUM(cost) AS cost
    FROM `data-analytics-mate.DA.paid_search_cost`
    GROUP BY date
) AS s
ORDER BY date;


-- 2. First Email Sent Date by Account
-- Identify the earliest email sending date for each account
-- using RANK() and PARTITION BY.

SELECT
    id_account AS account_id,
    all_date AS first_sent_date
FROM (
    SELECT
        *,
        RANK() OVER (
            PARTITION BY id_account
            ORDER BY all_date
        ) AS r_nmb
    FROM (
        SELECT
            es.id_account,
            DATE_ADD(
                s.date,
                INTERVAL es.sent_date DAY
            ) AS all_date
        FROM `data-analytics-mate.DA.email_sent` AS es
        JOIN `data-analytics-mate.DA.account_session` AS ac
            ON ac.account_id = es.id_account
        JOIN `data-analytics-mate.DA.session` AS s
            ON s.ga_session_id = ac.ga_session_id
    ) AS email_dates
) AS ranked_dates
WHERE r_nmb = 1
ORDER BY account_id;


-- 3. Account Ranking by Total Emails Sent
-- Count emails sent to each account and rank accounts
-- by email volume using DENSE_RANK().

SELECT
    account_id,
    total_emails,
    DENSE_RANK() OVER (
        ORDER BY total_emails DESC
    ) AS account_rank
FROM (
    SELECT
        id_account AS account_id,
        COUNT(*) AS total_emails
    FROM `data-analytics-mate.DA.email_sent`
    GROUP BY account_id
) AS em
ORDER BY account_rank;


-- 4. Email Sending Dates Ranked by Account
-- Rank unique email sending dates for each account,
-- starting from the most recent date.

SELECT
    id_account AS account_id,
    all_date AS sent_date,
    RANK() OVER (
        PARTITION BY id_account
        ORDER BY all_date DESC
    ) AS sent_day_rank
FROM (
    SELECT DISTINCT
        es.id_account,
        DATE_ADD(
            s.date,
            INTERVAL es.sent_date DAY
        ) AS all_date
    FROM `data-analytics-mate.DA.email_sent` AS es
    JOIN `data-analytics-mate.DA.account_session` AS ac
        ON ac.account_id = es.id_account
    JOIN `data-analytics-mate.DA.session` AS s
        ON s.ga_session_id = ac.ga_session_id
) AS email_dates
ORDER BY account_id, sent_day_rank;


-- 5. Monthly Email Distribution by Account
-- Calculate each account's percentage of emails
-- sent during a month.
-- Identify the first and last email sending dates
-- for each account within each month.

SELECT DISTINCT
    sent_month,
    account_id,

    ROUND(
        SAFE_DIVIDE(
            COUNT(id_message) OVER (
                PARTITION BY sent_month, account_id
            ),
            COUNT(id_message) OVER (
                PARTITION BY sent_month
            )
        ) * 100,
        2
    ) AS sent_msg_percent_from_this_month,

    MIN(all_date) OVER (
        PARTITION BY sent_month, account_id
    ) AS first_sent_date,

    MAX(all_date) OVER (
        PARTITION BY sent_month, account_id
    ) AS last_sent_date

FROM (
    SELECT
        DATE(
            EXTRACT(YEAR FROM all_date),
            EXTRACT(MONTH FROM all_date),
            1
        ) AS sent_month,
        id_account AS account_id,
        id_message,
        all_date
    FROM (
        SELECT
            es.id_account,
            es.id_message,
            DATE_ADD(
                s.date,
                INTERVAL es.sent_date DAY
            ) AS all_date
        FROM `data-analytics-mate.DA.email_sent` AS es
        JOIN `data-analytics-mate.DA.account_session` AS ac
            ON ac.account_id = es.id_account
        JOIN `data-analytics-mate.DA.session` AS s
            ON s.ga_session_id = ac.ga_session_id
    ) AS email_dates
) AS monthly_emails
ORDER BY sent_month, account_id;


-- 6. Cumulative Revenue vs. Predicted Revenue
-- Compare cumulative actual revenue with cumulative
-- predicted revenue over time.
-- Calculate the percentage of actual revenue
-- relative to predicted revenue.

SELECT
    date,
    ROUND(
        SAFE_DIVIDE(
            SUM(revenue) OVER (ORDER BY date),
            SUM(predict) OVER (ORDER BY date)
        ) * 100,
        2
    ) AS cum_percent
FROM (
    SELECT
        date,
        SUM(predict) AS predict,
        SUM(revenue) AS revenue
    FROM (
        -- Predicted revenue
        SELECT
            date,
            predict,
            0 AS revenue
        FROM `data-analytics-mate.DA.revenue_predict`

        UNION ALL

        -- Actual revenue
        SELECT
            s.date,
            0 AS predict,
            SUM(p.price) AS revenue
        FROM `data-analytics-mate.DA.session` AS s
        JOIN `data-analytics-mate.DA.order` AS o
            ON s.ga_session_id = o.ga_session_id
        JOIN `data-analytics-mate.DA.product` AS p
            ON p.item_id = o.item_id
        GROUP BY s.date
    ) AS combined_revenue
    GROUP BY date
) AS daily_revenue
ORDER BY date;
