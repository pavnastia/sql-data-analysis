
-- ============================================================
-- SQL Common Table Expressions (CTEs)
-- Topics: WITH, JOIN, UNION ALL, COUNT, SUM, CASE WHEN,
-- GROUP BY, Window Functions
-- Dataset: E-commerce (Google BigQuery)
-- ============================================================


-- 1. Monthly Email Activity by Account
-- Calculate each account's percentage of total emails
-- sent during a month.
-- Identify the first and last email sending dates
-- for each account within the month.

WITH email_sent_dates AS (
    -- Calculate the actual email sending dates
    SELECT
        es.id_account,
        es.id_message,
        DATE_ADD(
            s.date,
            INTERVAL es.sent_date DAY
        ) AS sent_date
    FROM `data-analytics-mate.DA.email_sent` AS es
    JOIN `data-analytics-mate.DA.account_session` AS ac
        ON ac.account_id = es.id_account
    JOIN `data-analytics-mate.DA.session` AS s
        ON s.ga_session_id = ac.ga_session_id
),

emails_by_month AS (
    -- Assign each email to its sending month
    SELECT
        DATE(
            EXTRACT(YEAR FROM sent_date),
            EXTRACT(MONTH FROM sent_date),
            1
        ) AS sent_month,
        id_account AS account_id,
        id_message,
        sent_date
    FROM email_sent_dates
),

monthly_email_totals AS (
    -- Calculate total emails sent each month
    SELECT
        sent_month,
        COUNT(id_message) AS total_sent_messages
    FROM emails_by_month
    GROUP BY sent_month
)

SELECT
    em.sent_month,
    em.account_id,
    ROUND(
        SAFE_DIVIDE(
            COUNT(em.id_message),
            MAX(t.total_sent_messages)
        ) * 100,
        2
    ) AS sent_msg_percent_from_this_month,
    MIN(em.sent_date) AS first_sent_date,
    MAX(em.sent_date) AS last_sent_date
FROM emails_by_month AS em
JOIN monthly_email_totals AS t
    ON t.sent_month = em.sent_month
GROUP BY
    em.sent_month,
    em.account_id
ORDER BY
    em.sent_month,
    em.account_id;



-- 2. Cumulative Actual vs. Predicted Revenue
-- Compare cumulative actual revenue with cumulative
-- predicted revenue over time using window functions.


WITH union_revenue_predict AS (
    -- Retrieve predicted revenue
    SELECT
        date,
        predict,
        0 AS revenue
    FROM `data-analytics-mate.DA.revenue_predict`

    UNION ALL

    -- Calculate actual revenue from product orders
    SELECT
        s.date,
        0 AS predict,
        SUM(p.price) AS revenue
    FROM `data-analytics-mate.DA.session` AS s
    JOIN `data-analytics-mate.DA.order` AS o
        ON s.ga_session_id = o.ga_session_id
    JOIN `data-analytics-mate.DA.product` AS p
        ON p.item_id = o.item_id
    GROUP BY s.date
),

revenue_predict_by_day AS (
    -- Aggregate actual and predicted revenue by date
    SELECT
        date,
        SUM(predict) AS predict,
        SUM(revenue) AS revenue
    FROM union_revenue_predict
    GROUP BY date
)

SELECT
    date,
    ROUND(
        SAFE_DIVIDE(
            SUM(revenue) OVER (ORDER BY date),
            SUM(predict) OVER (ORDER BY date)
        ) * 100,
        2
    ) AS cum_percent
FROM revenue_predict_by_day
ORDER BY date;


-- 3. Revenue and Account Metrics by Continent
-- Analyze revenue by device type and continent.
-- Calculate each continent's share of total revenue.
-- Combine revenue metrics with account and session data.


WITH revenue_usd AS (
    -- Calculate total revenue by continent and device type
    SELECT
        sp.continent,
        SUM(p.price) AS revenue,
        SUM(
            CASE
                WHEN sp.device = 'mobile' THEN p.price
            END
        ) AS revenue_from_mobile,
        SUM(
            CASE
                WHEN sp.device = 'desktop' THEN p.price
            END
        ) AS revenue_from_desktop
    FROM `data-analytics-mate.DA.order` AS o
    JOIN `data-analytics-mate.DA.product` AS p
        ON o.item_id = p.item_id
    JOIN `data-analytics-mate.DA.session_params` AS sp
        ON o.ga_session_id = sp.ga_session_id
    GROUP BY sp.continent
),

revenue AS (
    -- Calculate each continent's share of total revenue
    SELECT
        continent,
        revenue,
        revenue_from_mobile,
        revenue_from_desktop,
        ROUND(
            SAFE_DIVIDE(
                revenue,
                SUM(revenue) OVER()
            ) * 100,
            2
        ) AS percent_revenue_from_total
    FROM revenue_usd
),

account_session_verified_cnt AS (
    -- Calculate session, account, and verified account counts
    SELECT
        sp.continent,
        COUNT(sp.ga_session_id) AS session_cnt,
        COUNT(acs.account_id) AS account_cnt,
        COUNT(
            CASE
                WHEN ac.is_verified = 1 THEN ac.id
            END
        ) AS verified_account
    FROM `data-analytics-mate.DA.session_params` AS sp
    LEFT JOIN `data-analytics-mate.DA.account_session` AS acs
        ON sp.ga_session_id = acs.ga_session_id
    LEFT JOIN `data-analytics-mate.DA.account` AS ac
        ON ac.id = acs.account_id
    GROUP BY sp.continent
)

SELECT
    asv.continent,
    r.revenue,
    r.revenue_from_mobile,
    r.revenue_from_desktop,
    r.percent_revenue_from_total,
    asv.account_cnt,
    asv.verified_account,
    asv.session_cnt
FROM account_session_verified_cnt AS asv
LEFT JOIN revenue AS r
    ON r.continent = asv.continent
ORDER BY asv.continent;
