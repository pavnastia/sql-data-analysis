
-- ============================================================
-- SQL UNNEST & Nested Data
-- Topics: UNNEST, JOIN, CASE WHEN, COUNT, CONCAT,
-- CAST, ROUND, SAFE_DIVIDE, LOWER, LIKE
-- Dataset: E-commerce (Google BigQuery)
-- ============================================================


-- 1. Engaged Sessions by Device
-- Analyze the percentage of event records with
-- session_engaged = '1' across different device types.

SELECT
    sp.device,
    COUNT(p.ga_session_id) AS event_cnt,
    CONCAT(
        CAST(
            ROUND(
                SAFE_DIVIDE(
                    COUNT(
                        CASE
                            WHEN ep.value.string_value = '1'
                            THEN p.ga_session_id
                        END
                    ) * 100.0,
                    COUNT(p.ga_session_id)
                ),
                2
            ) AS STRING
        ),
        '%'
    ) AS pct_session_engaged_1
FROM `data-analytics-mate.DA.event_params` AS p
CROSS JOIN UNNEST(p.event_params) AS ep
JOIN `data-analytics-mate.DA.session_params` AS sp
    ON sp.ga_session_id = p.ga_session_id
WHERE ep.key = 'session_engaged'
    AND ep.value.string_value IS NOT NULL
GROUP BY sp.device;


-- 2. YouTube Page Views by Continent
-- Calculate the percentage of event records
-- containing 'youtube' in the page_title parameter
-- for each continent.

SELECT
    sp.continent,
    COUNT(p.ga_session_id) AS cnt_total,
    ROUND(
        SAFE_DIVIDE(
            COUNT(
                CASE
                    WHEN LOWER(ep.value.string_value) LIKE '%youtube%'
                    THEN p.ga_session_id
                END
            ) * 100.0,
            COUNT(p.ga_session_id)
        ),
        2
    ) AS pct_of_total
FROM `data-analytics-mate.DA.event_params` AS p
CROSS JOIN UNNEST(p.event_params) AS ep
JOIN `data-analytics-mate.DA.session_params` AS sp
    ON sp.ga_session_id = p.ga_session_id
WHERE ep.key = 'page_title'
    AND ep.value.string_value IS NOT NULL
GROUP BY sp.continent;
